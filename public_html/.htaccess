# Basic protection and speed settings.

# Do not let anyone list the contents of a folder
Options -Indexes

# Never serve these file types, whatever folder they are in
<FilesMatch "\.(sql|md|json|log)$">
  Require all denied
</FilesMatch>

# Nothing inside the uploads folder should ever run as a program
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^uploads/.*\.(php|phtml|phar|cgi|pl)$ - [F,L]
</IfModule>

# Let browsers keep images and scripts for a while
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg  "access plus 30 days"
  ExpiresByType image/png   "access plus 30 days"
  ExpiresByType image/webp  "access plus 30 days"
  ExpiresByType video/mp4   "access plus 30 days"
  ExpiresByType text/css    "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Compress text on the way out
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
